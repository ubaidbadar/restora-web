#!/bin/sh
set -eu

# Do not test a different snapshot from the one that will be committed.
if ! git diff --quiet; then
  echo "Commit blocked: tracked changes are not fully staged."
  echo "Stage the complete change set, or stash unrelated edits, then retry."
  exit 1
fi

untracked="$(git ls-files --others --exclude-standard)"
if [ -n "$untracked" ]; then
  echo "Commit blocked: new files are not staged:"
  printf '%s\n' "$untracked"
  echo "Stage the complete change set, or move unrelated files outside the repository."
  exit 1
fi

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
if ! printf '%s\n' "$staged" | grep -Eq '^(src/|shared/|public/|package\.json$|yarn\.lock$|tsconfig\.json$|vite\.config\.ts$|eslint\.config\.js$|index\.html$|firebase\.json$|\.firebaserc$|\.env\.example$|\.github/(workflows|scripts|order-page-e2e|authenticated-e2e|browser-smoke)/|\.githooks/)'; then
  echo "Documentation-only change: application test gate not needed."
  exit 0
fi

echo "Running the complete Restora Web pre-commit gate..."
yarn qa:verify
