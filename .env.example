# Copy to .env for development. Every name below is read by the app; a value left empty is simply not set.

# The app's own public address (no trailing slash), for link previews on WhatsApp and social media.
# Production: https://app.restora.live (dev site: https://dev-app.restora.live).
VITE_APP_URL=http://localhost:3000

# Where `vite dev` sends /api and /uploads (the backend's PORT). Defaults to http://localhost:5001.
# Also where a table's QR code leads when set, so in production builds leave it unset (it then uses https://restora.live).
VITE_API_PROXY=http://localhost:5001

# The API's address in a BUILT site (no trailing slash). Empty in development: the app calls /api on its own address
# and `vite dev` proxies it. Production: https://restora.live (dev site: https://dev.restora.live).
VITE_API_URL=

# Not read from this file. The Firebase Hosting deploy (GitHub Actions) sets VITE_APP_URL and VITE_API_URL for the build
# itself, and needs one secret: FIREBASE_SERVICE_ACCOUNT_RESTORA_LIVE (Settings, Secrets and variables, Actions).
