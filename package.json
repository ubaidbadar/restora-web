    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-router": "^7.18.4",
    "read-excel-file": "5.8.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.6",
    "@eslint/js": "^10.0.1",
    "@rolldown/plugin-babel": "^0.2.4",
